---
import { FooterEmailButton } from "@/components/FooterEmailButton";

const currentYear = new Date().getFullYear();

const navLinks = [
  { name: "Services", href: "#expertise" },
  { name: "Clients", href: "#clients" },
  { name: "Experience", href: "#experience" },
  { name: "Drupal", href: "#drupal" },
  { name: "Contact", href: "#contact" },
];

const profiles = [
  { label: "LinkedIn", url: "https://www.linkedin.com/in/alexburrows/" },
  { label: "GitHub", url: "https://github.com/alexburrows" },
  { label: "Medium", url: "https://medium.com/@aburrows" },
  { label: "Drupal.org", url: "https://www.drupal.org/u/aburrows" },
];
---

<footer class="site-footer">
  <div class="shell site-footer__cta">
    <h2 class="site-footer__cta-title font-heading">
      Let us build something reliable together.
    </h2>
    <p class="site-footer__cta-action">
      <FooterEmailButton client:load className="link" />
    </p>
  </div>

  <div class="shell site-footer__grid" data-reveal-stagger>
    <div>
      <p class="site-logo site-logo--footer font-heading">Alex Burrows</p>
      <p class="site-footer__location">
        Hampshire, United Kingdom<br />
        Available for consulting and contract leadership
      </p>
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="site-footer__link">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="site-footer__connect-label">Connect</p>
      <ul class="site-footer__links">
        {
          profiles.map((profile) => (
            <li>
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                class="site-footer__link"
              >
                {profile.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="https://digidrop.io"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer__link"
          >
            Digidrop Ltd
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="shell site-footer__legal">
    <p>© {currentYear} Alex Burrows</p>
    <p>CTO & Solution Architect</p>
  </div>
</footer>
