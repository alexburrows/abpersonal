---
const clients = [
  { name: "PwC", industry: "Professional services" },
  { name: "BBC", industry: "Media" },
  { name: "Worldpay", industry: "Fintech" },
  { name: "Pfizer", industry: "Pharmaceutical" },
  { name: "Toyota", industry: "Automotive" },
  { name: "National Grid", industry: "Energy" },
];

const moreClients = ["IHG", "Met Police", "Coty", "Travelopia"];
---

<section id="clients" class="section-pad section-surface page-section">
  <div class="shell">
    <div class="works-header" data-reveal>
      <div>
        <h2 class="works-header__title font-heading">Selected clients</h2>
      </div>
      <a href="#contact" class="link text-sm font-medium">Get in touch</a>
    </div>

    <ul class="client-list" data-reveal-stagger>
      {
        clients.map((client) => (
          <li class="client-list__item">
            <p class="client-list__name font-heading">{client.name}</p>
            <p class="client-list__industry">{client.industry}</p>
          </li>
        ))
      }
    </ul>

    <p class="works-more" data-reveal>
      Also {moreClients.join(", ")}, regulated industries and high-traffic public
      platforms where failure is not an option.
    </p>
  </div>
</section>
