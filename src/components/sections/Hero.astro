<section
  data-parallax-section
  data-parallax-hero
  class="relative overflow-hidden border-b border-border"
>
  <div
    data-parallax-bg
    class="parallax-glow parallax-glow--right"
    aria-hidden="true"
  />

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_16rem] lg:gap-20">
      <div data-parallax-hero-headline>
        <span data-parallax-line class="parallax-line" aria-hidden="true"></span>
        <p class="section-label">Alex Burrows</p>
        <h1 class="mt-3 max-w-2xl text-[2rem] leading-[1.12] tracking-tight sm:text-5xl">
          Enterprise platforms built to last.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">
          CTO and Solution Architect. Over 20 years designing and building
          critical systems for large organisations — TypeScript, React,
          Next.js, Drupal, and Laravel.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <button type="button" data-open-contact class="btn btn-primary link-arrow">
            Book a call
          </button>
          <a href="#contact" class="btn btn-secondary">Contact details</a>
        </div>
      </div>

      <aside
        data-parallax-hero-aside
        class="lg:border-l lg:border-border lg:pl-8"
      >
        <dl class="space-y-6 text-sm">
          <div>
            <dt class="section-label">Experience</dt>
            <dd class="mt-1 font-medium text-text-primary">20+ years</dd>
          </div>
          <div>
            <dt class="section-label">Role</dt>
            <dd class="mt-1 font-medium text-text-primary">
              Founder and CTO,
              <a
                href="https://digidrop.io"
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                Digidrop Ltd
              </a>
            </dd>
          </div>
          <div>
            <dt class="section-label">Based in</dt>
            <dd class="mt-1 font-medium text-text-primary">Hampshire, UK</dd>
          </div>
          <div>
            <dt class="section-label">Also</dt>
            <dd class="mt-1 text-text-secondary">
              Author · Open-source contributor
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
