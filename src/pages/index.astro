---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader";
import BookMeModal from "@/components/BookMeModal";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import Help from "@/components/sections/Help.astro";
import Experience from "@/components/sections/Experience.astro";
import Clients from "@/components/sections/Clients.astro";
import Drupal from "@/components/sections/Drupal.astro";
import TechStack from "@/components/sections/TechStack.astro";
import Contact from "@/components/sections/Contact.astro";
import PageAnimations from "@/components/PageAnimations";
---

<Layout>
  <div class="min-h-screen bg-background text-foreground">
    <SiteHeader client:load />
    <main class="page-main">
      <Hero />
      <Help />
      <Experience />
      <Clients />
      <Drupal />
      <TechStack />
      <Contact />
    </main>
    <Footer />
    <BookMeModal client:load />
    <PageAnimations client:load />
  </div>
</Layout>
