---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/700.css";
import "@fontsource/geist-mono/400.css";
import "@fontsource/geist-mono/500.css";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alex Burrows | CTO & Solution Architect",
  description = "CTO and Solution Architect with over 20 years' experience building enterprise platforms for PwC, BBC, Pfizer, Toyota, and others. TypeScript, React, Next.js, Drupal, and Laravel.",
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Alex Burrows, CTO, Solution Architect, Technical Leadership, TypeScript, React, Next.js, Drupal, Laravel, Enterprise Solutions"
    />
    <meta name="author" content="Alex Burrows" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="CTO and Solution Architect with over 20 years' experience building enterprise platforms for global organisations."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/file.svg" />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
